# ==============================================================================
# LawFlow 智律工作台 全局环境变量配置 (.env)
# ==============================================================================

# 核心大模型配置 (支持“本地私有 Ollama”与“云端大模型 API / DeepSeek”双模自适应)
# LLM_PROVIDER: auto (自动识别) / cloud (云端API) / ollama (本地模型) / rule_engine (专家规则免AI)
LLM_PROVIDER=auto
LLM_CLOUD_PRESET=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_CLOUD_MODEL=deepseek-chat

# 本地 Ollama 宿主机绑定
LLM_MODEL=gemma4:12b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Docassemble 引导式问卷 API Key 与内部容器访问地址
DA_API_KEY=lawflow_secret_key_2026
DOCASSEMBLE_URL=http://docassemble:80

# 司法文书处理中间件 Stirling-PDF (内部端口 8080，外部映射 8081)
STIRLING_PDF_URL=http://stirling-pdf:8080

# 私有类案 RAG 引擎 (RAGFlow 内部端口 9380)
RAGFLOW_URL=http://ragflow:9380

# 私有化电子合同签署系统 (DocuSeal 内部端口 3000，外部映射 8082)
DOCUSEAL_URL=http://docuseal:3000

# 宿主机直接通信与调试地址
HOST_OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma:latest

# 统一 API 网关端口配置 (全局端口注册表 5221)
GATEWAY_PORT=5221
GATEWAY_HOST=127.0.0.1

# 存储与字体路径
STORAGE_DIR=./storage
TEMPLATES_DIR=./templates
FONTS_DIR=./fonts
LOG_LEVEL=info
