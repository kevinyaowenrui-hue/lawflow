# ==============================================================================
# LawFlow 智律工作台 环境变量模板
# 复制为 .env 后填写；切勿提交真实密钥。
# ==============================================================================

# --- 鉴权与对外地址 ---
# API Token：外部调用需在请求头携带 X-LawFlow-Token
LAWFLOW_API_TOKEN=
# 对外可访问的本机基址（电子签回调等）
LAWFLOW_PUBLIC_BASE_URL=http://127.0.0.1:5221
# CORS / TrustedHost（逗号分隔）
LAWFLOW_ALLOWED_ORIGINS=http://127.0.0.1:5221,http://localhost:5221
LAWFLOW_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# --- 路径（默认相对仓库根目录；容器内由 compose 注入）---
LAWFLOW_BASE_DIR=
LAWFLOW_STORAGE_DIR=
LAWFLOW_FRONTEND_DIR=
LAWFLOW_TEMPLATES_DIR=
LAWFLOW_FONTS_DIR=
# LLM 设置文件（默认 ~/.lawflow/llm_settings.json）
LAWFLOW_SETTINGS_FILE=
# 可选：显式指定 .env 路径（一般无需设置）
LAWFLOW_DOTENV_FILE=
# 桌面启动器 / 脚本使用的 Python 解释器（可选）
LAWFLOW_PYTHON=

# --- 上传限制 ---
LAWFLOW_MAX_UPLOAD_MB=
LAWFLOW_MAX_UPLOAD_TOTAL_MB=

# --- 演示数据（仅开发；生产勿开）---
LAWFLOW_SEED_DEMO=

# --- 大模型 ---
# LLM_PROVIDER: auto | cloud | ollama | rule_engine
# auto：有云端密钥则走云端，否则本地 Ollama
LLM_PROVIDER=auto
LLM_CLOUD_PRESET=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_CLOUD_MODEL=deepseek-chat
LLM_MODEL=gemma4:12b
OLLAMA_BASE_URL=http://127.0.0.1:11434
HOST_OLLAMA_URL=
LAWFLOW_ALLOW_REMOTE_OLLAMA=
LAWFLOW_LLM_HOST_ALLOWLIST=
EMBEDDING_MODEL=

# --- 网关监听 ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=5221
# 仅调试需要时再设兼容端口，例如 8000
LAWFLOW_LEGACY_PORT=

# --- 日志 ---
LOG_LEVEL=INFO

# --- 可选中间件 URL ---
STIRLING_PDF_URL=http://127.0.0.1:8081
DOCUSEAL_URL=
# DocuSeal 回调密钥（phase3 profile / 真实签约时必填；勿使用弱默认值）
DOCUSEAL_WEBHOOK_SECRET=
DOCUSEAL_WEBHOOK_HEADER=

# --- 规划中组件（当前代码未使用；仅 docker compose --profile planned 需要）---
DA_API_KEY=
DOCASSEMBLE_URL=
RAGFLOW_URL=
