  "articles": [
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_1",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第一条",
      "article_no_int": 1,
      "content": "中华人民共和国国籍的取得、丧失和恢复，都适用本法。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_2",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第二条",
      "article_no_int": 2,
      "content": "中华人民共和国是统一的多民族的国家，各民族的人都具有中国国籍。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_3",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第三条",
      "article_no_int": 3,
      "content": "中华人民共和国不承认中国公民具有双重国籍。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_4",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第四条",
      "article_no_int": 4,
      "content": "父母双方或一方为中国公民，本人出生在中国，具有中国国籍。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_5",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第五条",
      "article_no_int": 5,
      "content": "父母双方或一方为中国公民，本人出生在外国，具有中国国籍；但父母双方或一方为中国公民并定居在外国，本人出生时即具有外国国籍的，不具有中国国籍。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_6",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第六条",
      "article_no_int": 6,
      "content": "父母无国籍或国籍不明，定居在中国，本人出生在中国，具有中国国籍。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_7",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第七条",
      "article_no_int": 7,
      "content": "外国人或无国籍人，愿意遵守中国宪法和法律，并具有下列条件之一的，可以经申请批准加入中国国籍：\n一、中国人的近亲属；\n二、定居在中国的；\n三、有其它正当理由。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_8",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第八条",
      "article_no_int": 8,
      "content": "申请加入中国国籍获得批准的，即取得中国国籍；被批准加入中国国籍的，不得再保留外国国籍。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_9",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第九条",
      "article_no_int": 9,
      "content": "定居外国的中国公民，自愿加入或取得外国国籍的，即自动丧失中国国籍。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_10",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十条",
      "article_no_int": 10,
      "content": "中国公民具有下列条件之一的，可以经申请批准退出中国国籍：\n一、外国人的近亲属；\n二、定居在外国的；\n三、有其它正当理由。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_11",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十一条",
      "article_no_int": 11,
      "content": "申请退出中国国籍获得批准的，即丧失中国国籍。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_12",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十二条",
      "article_no_int": 12,
      "content": "国家工作人员和现役军人，不得退出中国国籍。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_13",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十三条",
      "article_no_int": 13,
      "content": "曾有过中国国籍的外国人，具有正当理由，可以申请恢复中国国籍；被批准恢复中国国籍的，不得再保留外国国籍。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_14",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十四条",
      "article_no_int": 14,
      "content": "中国国籍的取得、丧失和恢复，除第九条规定的以外，必须办理申请手续。未满十八周岁的人，可由其父母或其他法定代理人代为办理申请。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_15",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十五条",
      "article_no_int": 15,
      "content": "受理国籍申请的机关，在国内为当地市、县公安局，在国外为中国外交代表机关和领事机关。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_16",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十六条",
      "article_no_int": 16,
      "content": "加入、退出和恢复中国国籍的申请，由中华人民共和国公安部审批。经批准的，由公安部发给证书。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf5aba10073:art_17",
      "law_id": "flk_2c909fdd678bf17901678bf5aba10073",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十七条",
      "article_no_int": 17,
      "content": "本法公布前，已经取得中国国籍的或已经丧失中国国籍的，继续有效。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf5aba10073",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
