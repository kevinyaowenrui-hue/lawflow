    {
      "id": "flk_2c909fdd678bf17901678bf6fd390523:art_42",
      "law_id": "flk_2c909fdd678bf17901678bf6fd390523",
      "part_name": "",
      "chapter_name": "第六章　群众防空组织",
      "section_name": "",
      "article_no_cn": "第四十二条",
      "article_no_int": 42,
      "content": "群众防空组织由下列部门负责组建：\n（一）城建、公用、电力等部门组建抢险抢修队；\n（二）卫生、医药部门组建医疗救护队；\n（三）公安部门组建消防队、治安队；\n（四）卫生、化工、环保等部门组建防化防疫队；\n（五）邮电部门组建通信队；\n（六）交通运输部门组建运输队。\n红十字会组织依法进行救护工作。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf6fd390523",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf6fd390523:art_43",
      "law_id": "flk_2c909fdd678bf17901678bf6fd390523",
