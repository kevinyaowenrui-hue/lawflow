      "chapter_name": "第六章　群众防空组织",
      "section_name": "",
      "article_no_cn": "第四十三条",
      "article_no_int": 43,
      "content": "群众防空组织所需装备、器材和经费由人民防空主管部门和组建单位提供。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf6fd390523",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf6fd390523:art_44",
      "law_id": "flk_2c909fdd678bf17901678bf6fd390523",
      "part_name": "",
      "chapter_name": "第六章　群众防空组织",
      "section_name": "",
      "article_no_cn": "第四十四条",
      "article_no_int": 44,
      "content": "群众防空组织应当根据人民防空主管部门制定的训练大纲和训练计划进行专业训练。",
      "has_proviso": 0,
