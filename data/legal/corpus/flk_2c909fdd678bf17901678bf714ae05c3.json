  "articles": [
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_1",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第一章　一般规定",
      "section_name": "",
      "article_no_cn": "第一条",
      "article_no_int": 1,
      "content": "为了明确涉外民事关系的法律适用，合理解决涉外民事争议，维护当事人的合法权益，制定本法。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_2",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第一章　一般规定",
      "section_name": "",
      "article_no_cn": "第二条",
      "article_no_int": 2,
      "content": "涉外民事关系适用的法律，依照本法确定。其他法律对涉外民事关系法律适用另有特别规定的，依照其规定。\n本法和其他法律对涉外民事关系法律适用没有规定的，适用与该涉外民事关系有最密切联系的法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_3",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第一章　一般规定",
      "section_name": "",
      "article_no_cn": "第三条",
      "article_no_int": 3,
      "content": "当事人依照法律规定可以明示选择涉外民事关系适用的法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_4",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第一章　一般规定",
      "section_name": "",
      "article_no_cn": "第四条",
      "article_no_int": 4,
      "content": "中华人民共和国法律对涉外民事关系有强制性规定的，直接适用该强制性规定。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_5",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第一章　一般规定",
      "section_name": "",
      "article_no_cn": "第五条",
      "article_no_int": 5,
      "content": "外国法律的适用将损害中华人民共和国社会公共利益的，适用中华人民共和国法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_6",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第一章　一般规定",
      "section_name": "",
      "article_no_cn": "第六条",
      "article_no_int": 6,
      "content": "涉外民事关系适用外国法律，该国不同区域实施不同法律的，适用与该涉外民事关系有最密切联系区域的法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_7",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第一章　一般规定",
      "section_name": "",
      "article_no_cn": "第七条",
      "article_no_int": 7,
      "content": "诉讼时效，适用相关涉外民事关系应当适用的法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_8",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第一章　一般规定",
      "section_name": "",
      "article_no_cn": "第八条",
      "article_no_int": 8,
      "content": "涉外民事关系的定性，适用法院地法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_9",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第一章　一般规定",
      "section_name": "",
      "article_no_cn": "第九条",
      "article_no_int": 9,
      "content": "涉外民事关系适用的外国法律，不包括该国的法律适用法。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_10",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第一章　一般规定",
      "section_name": "",
      "article_no_cn": "第十条",
      "article_no_int": 10,
      "content": "涉外民事关系适用的外国法律，由人民法院、仲裁机构或者行政机关查明。当事人选择适用外国法律的，应当提供该国法律。\n不能查明外国法律或者该国法律没有规定的，适用中华人民共和国法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_11",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第二章　民事主体",
      "section_name": "",
      "article_no_cn": "第十一条",
      "article_no_int": 11,
      "content": "自然人的民事权利能力，适用经常居所地法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_12",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第二章　民事主体",
      "section_name": "",
      "article_no_cn": "第十二条",
      "article_no_int": 12,
      "content": "自然人的民事行为能力，适用经常居所地法律。\n自然人从事民事活动，依照经常居所地法律为无民事行为能力，依照行为地法律为有民事行为能力的，适用行为地法律，但涉及婚姻家庭、继承的除外。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_13",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第二章　民事主体",
      "section_name": "",
      "article_no_cn": "第十三条",
      "article_no_int": 13,
      "content": "宣告失踪或者宣告死亡，适用自然人经常居所地法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_14",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第二章　民事主体",
      "section_name": "",
      "article_no_cn": "第十四条",
      "article_no_int": 14,
      "content": "法人及其分支机构的民事权利能力、民事行为能力、组织机构、股东权利义务等事项，适用登记地法律。\n法人的主营业地与登记地不一致的，可以适用主营业地法律。法人的经常居所地，为其主营业地。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_15",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第二章　民事主体",
      "section_name": "",
      "article_no_cn": "第十五条",
      "article_no_int": 15,
      "content": "人格权的内容，适用权利人经常居所地法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_16",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第二章　民事主体",
      "section_name": "",
      "article_no_cn": "第十六条",
      "article_no_int": 16,
      "content": "代理适用代理行为地法律，但被代理人与代理人的民事关系，适用代理关系发生地法律。\n当事人可以协议选择委托代理适用的法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_17",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第二章　民事主体",
      "section_name": "",
      "article_no_cn": "第十七条",
      "article_no_int": 17,
      "content": "当事人可以协议选择信托适用的法律。当事人没有选择的，适用信托财产所在地法律或者信托关系发生地法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_18",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第二章　民事主体",
      "section_name": "",
      "article_no_cn": "第十八条",
      "article_no_int": 18,
      "content": "当事人可以协议选择仲裁协议适用的法律。当事人没有选择的，适用仲裁机构所在地法律或者仲裁地法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_19",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第二章　民事主体",
      "section_name": "",
      "article_no_cn": "第十九条",
      "article_no_int": 19,
      "content": "依照本法适用国籍国法律，自然人具有两个以上国籍的，适用有经常居所的国籍国法律；在所有国籍国均无经常居所的，适用与其有最密切联系的国籍国法律。自然人无国籍或者国籍不明的，适用其经常居所地法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_20",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第二章　民事主体",
      "section_name": "",
      "article_no_cn": "第二十条",
      "article_no_int": 20,
      "content": "依照本法适用经常居所地法律，自然人经常居所地不明的，适用其现在居所地法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_21",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第三章　婚姻家庭",
      "section_name": "",
      "article_no_cn": "第二十一条",
      "article_no_int": 21,
      "content": "结婚条件，适用当事人共同经常居所地法律；没有共同经常居所地的，适用共同国籍国法律；没有共同国籍，在一方当事人经常居所地或者国籍国缔结婚姻的，适用婚姻缔结地法律。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf714ae05c3",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf714ae05c3:art_22",
      "law_id": "flk_2c909fdd678bf17901678bf714ae05c3",
      "part_name": "",
      "chapter_name": "第三章　婚姻家庭",
      "section_name": "",
      "article_no_cn": "第二十二条",
      "article_no_int": 22,
      "content": "结婚手续，符合婚姻缔结地法律、一方当事人经常居所地法律或者国籍国法律的，均为有效。",
