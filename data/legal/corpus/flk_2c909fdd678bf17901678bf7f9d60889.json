      "short_name": "反家庭暴力法",
      "hierarchy": 1,
      "promulgated_by": "全国人民代表大会常务委员会",
      "promulgated_doc_no": "",
      "effective_date": "2016-03-01",
      "status": "VALID",
      "domain": "社会",
      "summary": "国家法律法规数据库现行文本全文导入。",
      "version_note": "官网全文自动切条，待律师抽核。",
