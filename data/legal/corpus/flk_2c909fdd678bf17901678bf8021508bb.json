      "full_name": "中华人民共和国深海海底区域资源勘探开发法",
      "short_name": "深海海底区域资源勘探开发法",
      "hierarchy": 1,
      "promulgated_by": "全国人民代表大会常务委员会",
      "promulgated_doc_no": "",
      "effective_date": "2016-05-01",
      "status": "VALID",
