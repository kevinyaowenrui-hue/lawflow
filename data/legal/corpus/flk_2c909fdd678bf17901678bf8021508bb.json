    }
  ],
  "articles": [
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_1",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第一条",
      "article_no_int": 1,
      "content": "为了规范深海海底区域资源勘探、开发活动，推进深海科学技术研究、资源调查，保护海洋环境，促进深海海底区域资源可持续利用，维护人类共同利益，制定本法。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_2",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第二条",
      "article_no_int": 2,
      "content": "中华人民共和国的公民、法人或者其他组织从事深海海底区域资源勘探、开发和相关环境保护、科学技术研究、资源调查活动，适用本法。\n本法所称深海海底区域，是指中华人民共和国和其他国家管辖范围以外的海床、洋底及其底土。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_3",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第三条",
      "article_no_int": 3,
      "content": "深海海底区域资源勘探、开发活动应当坚持和平利用、合作共享、保护环境、维护人类共同利益的原则。\n国家保护从事深海海底区域资源勘探、开发和资源调查活动的中华人民共和国公民、法人或者其他组织的正当权益。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_4",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第四条",
      "article_no_int": 4,
      "content": "国家制定有关深海海底区域资源勘探、开发规划，并采取经济、技术政策和措施，鼓励深海科学技术研究和资源调查，提升资源勘探、开发和海洋环境保护的能力。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_5",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第五条",
      "article_no_int": 5,
      "content": "国务院海洋主管部门负责对深海海底区域资源勘探、开发和资源调查活动的监督管理。国务院其他有关部门按照国务院规定的职责负责相关管理工作。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_6",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第六条",
      "article_no_int": 6,
      "content": "国家鼓励和支持在深海海底区域资源勘探、开发和相关环境保护、资源调查、科学技术研究和教育培训等方面，开展国际合作。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_7",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第二章　勘探、开发",
      "section_name": "",
      "article_no_cn": "第七条",
      "article_no_int": 7,
      "content": "中华人民共和国的公民、法人或者其他组织在向国际海底管理局申请从事深海海底区域资源勘探、开发活动前，应当向国务院海洋主管部门提出申请，并提交下列材料：\n（一）申请者基本情况；\n（二）拟勘探、开发区域位置、面积、矿产种类等说明；\n（三）财务状况、投资能力证明和技术能力说明；\n（四）勘探、开发工作计划，包括勘探、开发活动可能对海洋环境造成影响的相关资料，海洋环境严重损害等的应急预案；\n（五）国务院海洋主管部门规定的其他材料。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_8",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第二章　勘探、开发",
      "section_name": "",
      "article_no_cn": "第八条",
      "article_no_int": 8,
      "content": "国务院海洋主管部门应当对申请者提交的材料进行审查，对于符合国家利益并具备资金、技术、装备等能力条件的，应当在六十个工作日内予以许可，并出具相关文件。\n获得许可的申请者在与国际海底管理局签订勘探、开发合同成为承包者后，方可从事勘探、开发活动。\n承包者应当自勘探、开发合同签订之日起三十日内，将合同副本报国务院海洋主管部门备案。\n国务院海洋主管部门应当将承包者及其勘探、开发的区域位置、面积等信息通报有关机关。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_9",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第二章　勘探、开发",
      "section_name": "",
      "article_no_cn": "第九条",
      "article_no_int": 9,
      "content": "承包者对勘探、开发合同区域内特定资源享有相应的专属勘探、开发权。\n承包者应当履行勘探、开发合同义务，保障从事勘探、开发作业人员的人身安全，保护海洋环境。\n承包者从事勘探、开发作业应当保护作业区域内的文物、铺设物等。\n承包者从事勘探、开发作业还应当遵守中华人民共和国有关安全生产、劳动保护方面的法律、行政法规。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_10",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第二章　勘探、开发",
      "section_name": "",
      "article_no_cn": "第十条",
      "article_no_int": 10,
      "content": "承包者在转让勘探、开发合同的权利、义务前，或者在对勘探、开发合同作出重大变更前，应当报经国务院海洋主管部门同意。\n承包者应当自勘探、开发合同转让、变更或者终止之日起三十日内，报国务院海洋主管部门备案。\n国务院海洋主管部门应当及时将勘探、开发合同转让、变更或者终止的信息通报有关机关。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_11",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第二章　勘探、开发",
      "section_name": "",
      "article_no_cn": "第十一条",
      "article_no_int": 11,
      "content": "发生或者可能发生严重损害海洋环境等事故，承包者应当立即启动应急预案，并采取下列措施：\n（一）立即发出警报；\n（二）立即报告国务院海洋主管部门，国务院海洋主管部门应当及时通报有关机关；\n（三）采取一切实际可行与合理的措施，防止、减少、控制对人身、财产、海洋环境的损害。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_12",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第三章　环境保护",
      "section_name": "",
      "article_no_cn": "第十二条",
      "article_no_int": 12,
      "content": "承包者应当在合理、可行的范围内，利用可获得的先进技术，采取必要措施，防止、减少、控制勘探、开发区域内的活动对海洋环境造成的污染和其他危害。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_13",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第三章　环境保护",
      "section_name": "",
      "article_no_cn": "第十三条",
      "article_no_int": 13,
      "content": "承包者应当按照勘探、开发合同的约定和要求、国务院海洋主管部门规定，调查研究勘探、开发区域的海洋状况，确定环境基线，评估勘探、开发活动可能对海洋环境的影响；制定和执行环境监测方案，监测勘探、开发活动对勘探、开发区域海洋环境的影响，并保证监测设备正常运行，保存原始监测记录。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_14",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第三章　环境保护",
      "section_name": "",
      "article_no_cn": "第十四条",
      "article_no_int": 14,
      "content": "承包者从事勘探、开发活动应当采取必要措施，保护和保全稀有或者脆弱的生态系统，以及衰竭、受威胁或者有灭绝危险的物种和其他海洋生物的生存环境，保护海洋生物多样性，维护海洋资源的可持续利用。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_15",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第四章　科学技术研究与资源调查",
      "section_name": "",
      "article_no_cn": "第十五条",
      "article_no_int": 15,
      "content": "国家支持深海科学技术研究和专业人才培养，将深海科学技术列入科学技术发展的优先领域，鼓励与相关产业的合作研究。\n国家支持企业进行深海科学技术研究与技术装备研发。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_16",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第四章　科学技术研究与资源调查",
      "section_name": "",
      "article_no_cn": "第十六条",
      "article_no_int": 16,
      "content": "国家支持深海公共平台的建设和运行，建立深海公共平台共享合作机制，为深海科学技术研究、资源调查活动提供专业服务，促进深海科学技术交流、合作及成果共享。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_17",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第四章　科学技术研究与资源调查",
      "section_name": "",
      "article_no_cn": "第十七条",
      "article_no_int": 17,
      "content": "国家鼓励单位和个人通过开放科学考察船舶、实验室、陈列室和其他场地、设施，举办讲座或者提供咨询等多种方式，开展深海科学普及活动。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_18",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第四章　科学技术研究与资源调查",
      "section_name": "",
      "article_no_cn": "第十八条",
      "article_no_int": 18,
      "content": "从事深海海底区域资源调查活动的公民、法人或者其他组织，应当按照有关规定将有关资料副本、实物样本或者目录汇交国务院海洋主管部门和其他相关部门。负责接受汇交的部门应当对汇交的资料和实物样本进行登记、保管，并按照有关规定向社会提供利用。\n承包者从事深海海底区域资源勘探、开发活动取得的有关资料、实物样本等的汇交，适用前款规定。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_19",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第五章　监督检查",
      "section_name": "",
      "article_no_cn": "第十九条",
      "article_no_int": 19,
      "content": "国务院海洋主管部门应当对承包者勘探、开发活动进行监督检查。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_20",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第五章　监督检查",
      "section_name": "",
      "article_no_cn": "第二十条",
      "article_no_int": 20,
      "content": "承包者应当定期向国务院海洋主管部门报告下列履行勘探、开发合同的事项：\n（一）勘探、开发活动情况；\n（二）环境监测情况；\n（三）年度投资情况；\n（四）国务院海洋主管部门要求的其他事项。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_21",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第五章　监督检查",
      "section_name": "",
      "article_no_cn": "第二十一条",
      "article_no_int": 21,
      "content": "国务院海洋主管部门可以检查承包者用于勘探、开发活动的船舶、设施、设备以及航海日志、记录、数据等。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_22",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第五章　监督检查",
      "section_name": "",
      "article_no_cn": "第二十二条",
      "article_no_int": 22,
      "content": "承包者应当对国务院海洋主管部门的监督检查予以协助、配合。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_23",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第六章　法律责任",
      "section_name": "",
      "article_no_cn": "第二十三条",
      "article_no_int": 23,
      "content": "违反本法第七条、第九条第二款、第十条第一款规定，有下列行为之一的，国务院海洋主管部门可以撤销许可并撤回相关文件：\n（一）提交虚假材料取得许可的；\n（二）不履行勘探、开发合同义务或者履行合同义务不符合约定的；\n（三）未经同意，转让勘探、开发合同的权利、义务或者对勘探、开发合同作出重大变更的。\n承包者有前款第二项行为的，还应当承担相应的赔偿责任。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_24",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第六章　法律责任",
      "section_name": "",
      "article_no_cn": "第二十四条",
      "article_no_int": 24,
      "content": "违反本法第八条第三款、第十条第二款、第十八条、第二十条、第二十二条规定，有下列行为之一的，由国务院海洋主管部门责令改正，处二万元以上十万元以下的罚款：\n（一）未按规定将勘探、开发合同副本报备案的；\n（二）转让、变更或者终止勘探、开发合同，未按规定报备案的；\n（三）未按规定汇交有关资料副本、实物样本或者目录的；\n（四）未按规定报告履行勘探、开发合同事项的；\n（五）不协助、配合监督检查的。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_25",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第六章　法律责任",
      "section_name": "",
      "article_no_cn": "第二十五条",
      "article_no_int": 25,
      "content": "违反本法第八条第二款规定，未经许可或者未签订勘探、开发合同从事深海海底区域资源勘探、开发活动的，由国务院海洋主管部门责令停止违法行为，处十万元以上五十万元以下的罚款；有违法所得的，并处没收违法所得。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_26",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第六章　法律责任",
      "section_name": "",
      "article_no_cn": "第二十六条",
      "article_no_int": 26,
      "content": "违反本法第九条第三款、第十一条、第十二条规定，造成海洋环境污染损害或者作业区域内文物、铺设物等损害的，由国务院海洋主管部门责令停止违法行为，处五十万元以上一百万元以下的罚款；构成犯罪的，依法追究刑事责任。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_27",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第七章　附　　则",
      "section_name": "",
      "article_no_cn": "第二十七条",
      "article_no_int": 27,
      "content": "本法下列用语的含义：\n（一）勘探，是指在深海海底区域探寻资源，分析资源，使用和测试资源采集系统和设备、加工设施及运输系统，以及对开发时应当考虑的环境、技术、经济、商业和其他有关因素的研究。\n（二）开发，是指在深海海底区域为商业目的收回并选取资源，包括建造和操作为生产和销售资源服务的采集、加工和运输系统。\n（三）资源调查，是指在深海海底区域搜寻资源，包括估计资源成分、多少和分布情况及经济价值。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf8021508bb",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf8021508bb:art_28",
      "law_id": "flk_2c909fdd678bf17901678bf8021508bb",
      "part_name": "",
      "chapter_name": "第七章　附　　则",
      "section_name": "",
      "article_no_cn": "第二十八条",
      "article_no_int": 28,
      "content": "深海海底区域资源开发活动涉税事项，依照中华人民共和国税收法律、行政法规的规定执行。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
