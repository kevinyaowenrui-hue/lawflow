  "articles": [
    {
      "id": "flk_2c909fdd678bf17901678bf88e4e0b1d:art_1",
      "law_id": "flk_2c909fdd678bf17901678bf88e4e0b1d",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第一条",
      "article_no_int": 1,
      "content": "在中华人民共和国境内，依照《中华人民共和国烟草专卖法》的规定收购烟叶的单位为烟叶税的纳税人。纳税人应当依照本法规定缴纳烟叶税。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf88e4e0b1d",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf88e4e0b1d:art_2",
      "law_id": "flk_2c909fdd678bf17901678bf88e4e0b1d",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第二条",
      "article_no_int": 2,
      "content": "本法所称烟叶，是指烤烟叶、晾晒烟叶。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf88e4e0b1d",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf88e4e0b1d:art_3",
      "law_id": "flk_2c909fdd678bf17901678bf88e4e0b1d",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第三条",
      "article_no_int": 3,
      "content": "烟叶税的计税依据为纳税人收购烟叶实际支付的价款总额。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf88e4e0b1d",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf88e4e0b1d:art_4",
      "law_id": "flk_2c909fdd678bf17901678bf88e4e0b1d",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第四条",
      "article_no_int": 4,
      "content": "烟叶税的税率为百分之二十。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf88e4e0b1d",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf88e4e0b1d:art_5",
      "law_id": "flk_2c909fdd678bf17901678bf88e4e0b1d",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第五条",
      "article_no_int": 5,
      "content": "烟叶税的应纳税额按照纳税人收购烟叶实际支付的价款总额乘以税率计算。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf88e4e0b1d",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf88e4e0b1d:art_6",
      "law_id": "flk_2c909fdd678bf17901678bf88e4e0b1d",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第六条",
      "article_no_int": 6,
      "content": "烟叶税由税务机关依照本法和《中华人民共和国税收征收管理法》的有关规定征收管理。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf88e4e0b1d",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf88e4e0b1d:art_7",
      "law_id": "flk_2c909fdd678bf17901678bf88e4e0b1d",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第七条",
      "article_no_int": 7,
      "content": "纳税人应当向烟叶收购地的主管税务机关申报缴纳烟叶税。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf88e4e0b1d",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf88e4e0b1d:art_8",
      "law_id": "flk_2c909fdd678bf17901678bf88e4e0b1d",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第八条",
      "article_no_int": 8,
      "content": "烟叶税的纳税义务发生时间为纳税人收购烟叶的当日。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf88e4e0b1d",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf88e4e0b1d:art_9",
      "law_id": "flk_2c909fdd678bf17901678bf88e4e0b1d",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第九条",
      "article_no_int": 9,
      "content": "烟叶税按月计征，纳税人应当于纳税义务发生月终了之日起十五日内申报并缴纳税款。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=2c909fdd678bf17901678bf88e4e0b1d",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_2c909fdd678bf17901678bf88e4e0b1d:art_10",
      "law_id": "flk_2c909fdd678bf17901678bf88e4e0b1d",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十条",
      "article_no_int": 10,
      "content": "本法自2018年7月1日起施行。2006年4月28日国务院公布的《中华人民共和国烟叶税暂行条例》同时废止。",
