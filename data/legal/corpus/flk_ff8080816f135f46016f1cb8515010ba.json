  "articles": [
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_1",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第一条",
      "article_no_int": 1,
      "content": "为了规范人民检察院的设置、组织和职权，保障人民检察院依法履行职责，根据宪法，制定本法。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_2",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第二条",
      "article_no_int": 2,
      "content": "人民检察院是国家的法律监督机关。\n人民检察院通过行使检察权，追诉犯罪，维护国家安全和社会秩序，维护个人和组织的合法权益，维护国家利益和社会公共利益，保障法律正确实施，维护社会公平正义，维护国家法制统一、尊严和权威，保障中国特色社会主义建设的顺利进行。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_3",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第三条",
      "article_no_int": 3,
      "content": "人民检察院依照宪法、法律和全国人民代表大会常务委员会的决定设置。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_4",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第四条",
      "article_no_int": 4,
      "content": "人民检察院依照法律规定独立行使检察权，不受行政机关、社会团体和个人的干涉。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_5",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第五条",
      "article_no_int": 5,
      "content": "人民检察院行使检察权在适用法律上一律平等，不允许任何组织和个人有超越法律的特权，禁止任何形式的歧视。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_6",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第六条",
      "article_no_int": 6,
      "content": "人民检察院坚持司法公正，以事实为根据，以法律为准绳，遵守法定程序，尊重和保障人权。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_7",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第七条",
      "article_no_int": 7,
      "content": "人民检察院实行司法公开，法律另有规定的除外。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_8",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第八条",
      "article_no_int": 8,
      "content": "人民检察院实行司法责任制，建立健全权责统一的司法权力运行机制。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_9",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第九条",
      "article_no_int": 9,
      "content": "最高人民检察院对全国人民代表大会及其常务委员会负责并报告工作。地方各级人民检察院对本级人民代表大会及其常务委员会负责并报告工作。\n各级人民代表大会及其常务委员会对本级人民检察院的工作实施监督。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_10",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第十条",
      "article_no_int": 10,
      "content": "最高人民检察院是最高检察机关。\n最高人民检察院领导地方各级人民检察院和专门人民检察院的工作，上级人民检察院领导下级人民检察院的工作。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_11",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第一章　总　　则",
      "section_name": "",
      "article_no_cn": "第十一条",
      "article_no_int": 11,
      "content": "人民检察院应当接受人民群众监督，保障人民群众对人民检察院工作依法享有知情权、参与权和监督权。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_12",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第十二条",
      "article_no_int": 12,
      "content": "人民检察院分为：\n（一）最高人民检察院；\n（二）地方各级人民检察院；\n（三）军事检察院等专门人民检察院。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_13",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第十三条",
      "article_no_int": 13,
      "content": "地方各级人民检察院分为：\n（一）省级人民检察院，包括省、自治区、直辖市人民检察院；\n（二）设区的市级人民检察院，包括省、自治区辖市人民检察院，自治州人民检察院，省、自治区、直辖市人民检察院分院；\n（三）基层人民检察院，包括县、自治县、不设区的市、市辖区人民检察院。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_14",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第十四条",
      "article_no_int": 14,
      "content": "在新疆生产建设兵团设立的人民检察院的组织、案件管辖范围和检察官任免，依照全国人民代表大会常务委员会的有关规定。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_15",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第十五条",
      "article_no_int": 15,
      "content": "专门人民检察院的设置、组织、职权和检察官任免，由全国人民代表大会常务委员会规定。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_16",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第十六条",
      "article_no_int": 16,
      "content": "省级人民检察院和设区的市级人民检察院根据检察工作需要，经最高人民检察院和省级有关部门同意，并提请本级人民代表大会常务委员会批准，可以在辖区内特定区域设立人民检察院，作为派出机构。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_17",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第十七条",
      "article_no_int": 17,
      "content": "人民检察院根据检察工作需要，可以在监狱、看守所等场所设立检察室，行使派出它的人民检察院的部分职权，也可以对上述场所进行巡回检察。\n省级人民检察院设立检察室，应当经最高人民检察院和省级有关部门同意。设区的市级人民检察院、基层人民检察院设立检察室，应当经省级人民检察院和省级有关部门同意。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_18",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第十八条",
      "article_no_int": 18,
      "content": "人民检察院根据检察工作需要，设必要的业务机构。检察官员额较少的设区的市级人民检察院和基层人民检察院，可以设综合业务机构。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_19",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第十九条",
      "article_no_int": 19,
      "content": "人民检察院根据工作需要，可以设必要的检察辅助机构和行政管理机构。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_20",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第二十条",
      "article_no_int": 20,
      "content": "人民检察院行使下列职权：\n（一）依照法律规定对有关刑事案件行使侦查权；\n（二）对刑事案件进行审查，批准或者决定是否逮捕犯罪嫌疑人；\n（三）对刑事案件进行审查，决定是否提起公诉，对决定提起公诉的案件支持公诉；\n（四）依照法律规定提起公益诉讼；\n（五）对诉讼活动实行法律监督；\n（六）对判决、裁定等生效法律文书的执行工作实行法律监督；\n（七）对监狱、看守所的执法活动实行法律监督；\n（八）法律规定的其他职权。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_21",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第二十一条",
      "article_no_int": 21,
      "content": "人民检察院行使本法第二十条规定的法律监督职权，可以进行调查核实，并依法提出抗诉、纠正意见、检察建议。有关单位应当予以配合，并及时将采纳纠正意见、检察建议的情况书面回复人民检察院。\n抗诉、纠正意见、检察建议的适用范围及其程序，依照法律有关规定。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_22",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第二十二条",
      "article_no_int": 22,
      "content": "最高人民检察院对最高人民法院的死刑复核活动实行监督；对报请核准追诉的案件进行审查，决定是否追诉。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_23",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第二十三条",
      "article_no_int": 23,
      "content": "最高人民检察院可以对属于检察工作中具体应用法律的问题进行解释。\n最高人民检察院可以发布指导性案例。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_24",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第二十四条",
      "article_no_int": 24,
      "content": "上级人民检察院对下级人民检察院行使下列职权：\n（一）认为下级人民检察院的决定错误的，指令下级人民检察院纠正，或者依法撤销、变更；\n（二）可以对下级人民检察院管辖的案件指定管辖；\n（三）可以办理下级人民检察院管辖的案件；\n（四）可以统一调用辖区的检察人员办理案件。\n上级人民检察院的决定，应当以书面形式作出。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_25",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第二十五条",
      "article_no_int": 25,
      "content": "下级人民检察院应当执行上级人民检察院的决定；有不同意见的，可以在执行的同时向上级人民检察院报告。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_26",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第二十六条",
      "article_no_int": 26,
      "content": "人民检察院检察长或者检察长委托的副检察长，可以列席同级人民法院审判委员会会议。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_27",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第二章　人民检察院的设置和职权",
      "section_name": "",
      "article_no_cn": "第二十七条",
      "article_no_int": 27,
      "content": "人民监督员依照规定对人民检察院的办案活动实行监督。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_28",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第三章　人民检察院的办案组织",
      "section_name": "",
      "article_no_cn": "第二十八条",
      "article_no_int": 28,
      "content": "人民检察院办理案件，根据案件情况可以由一名检察官独任办理，也可以由两名以上检察官组成办案组办理。\n由检察官办案组办理的，检察长应当指定一名检察官担任主办检察官，组织、指挥办案组办理案件。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_29",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第三章　人民检察院的办案组织",
      "section_name": "",
      "article_no_cn": "第二十九条",
      "article_no_int": 29,
      "content": "检察官在检察长领导下开展工作，重大办案事项由检察长决定。检察长可以将部分职权委托检察官行使，可以授权检察官签发法律文书。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_30",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第三章　人民检察院的办案组织",
      "section_name": "",
      "article_no_cn": "第三十条",
      "article_no_int": 30,
      "content": "各级人民检察院设检察委员会。检察委员会由检察长、副检察长和若干资深检察官组成，成员应当为单数。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_31",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第三章　人民检察院的办案组织",
      "section_name": "",
      "article_no_cn": "第三十一条",
      "article_no_int": 31,
      "content": "检察委员会履行下列职能：\n（一）总结检察工作经验；\n（二）讨论决定重大、疑难、复杂案件；\n（三）讨论决定其他有关检察工作的重大问题。\n最高人民检察院对属于检察工作中具体应用法律的问题进行解释、发布指导性案例，应当由检察委员会讨论通过。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_32",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第三章　人民检察院的办案组织",
      "section_name": "",
      "article_no_cn": "第三十二条",
      "article_no_int": 32,
      "content": "检察委员会召开会议，应当有其组成人员的过半数出席。\n检察委员会会议由检察长或者检察长委托的副检察长主持。检察委员会实行民主集中制。\n地方各级人民检察院的检察长不同意本院检察委员会多数人的意见，属于办理案件的，可以报请上一级人民检察院决定；属于重大事项的，可以报请上一级人民检察院或者本级人民代表大会常务委员会决定。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_33",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第三章　人民检察院的办案组织",
      "section_name": "",
      "article_no_cn": "第三十三条",
      "article_no_int": 33,
      "content": "检察官可以就重大案件和其他重大问题，提请检察长决定。检察长可以根据案件情况，提交检察委员会讨论决定。\n检察委员会讨论案件，检察官对其汇报的事实负责，检察委员会委员对本人发表的意见和表决负责。检察委员会的决定，检察官应当执行。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_34",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第三章　人民检察院的办案组织",
      "section_name": "",
      "article_no_cn": "第三十四条",
      "article_no_int": 34,
      "content": "人民检察院实行检察官办案责任制。检察官对其职权范围内就案件作出的决定负责。检察长、检察委员会对案件作出决定的，承担相应责任。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_35",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第四章　人民检察院的人员组成",
      "section_name": "",
      "article_no_cn": "第三十五条",
      "article_no_int": 35,
      "content": "人民检察院的检察人员由检察长、副检察长、检察委员会委员和检察员等人员组成。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_36",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第四章　人民检察院的人员组成",
      "section_name": "",
      "article_no_cn": "第三十六条",
      "article_no_int": 36,
      "content": "人民检察院检察长领导本院检察工作，管理本院行政事务。人民检察院副检察长协助检察长工作。",
      "has_proviso": 0,
