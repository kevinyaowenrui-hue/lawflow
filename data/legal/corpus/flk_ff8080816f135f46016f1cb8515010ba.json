      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_45",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第四章　人民检察院的人员组成",
      "section_name": "",
      "article_no_cn": "第四十五条",
      "article_no_int": 45,
      "content": "人民检察院的司法警察负责办案场所警戒、人员押解和看管等警务事项。\n司法警察依照《中华人民共和国人民警察法》管理。",
      "has_proviso": 0,
