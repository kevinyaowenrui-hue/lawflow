      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第四章　人民检察院的人员组成",
      "section_name": "",
      "article_no_cn": "第四十六条",
      "article_no_int": 46,
      "content": "人民检察院根据检察工作需要，可以设检察技术人员，负责与检察工作有关的事项。",
      "has_proviso": 0,
