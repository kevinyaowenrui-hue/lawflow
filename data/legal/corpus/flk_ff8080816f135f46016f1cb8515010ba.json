    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_39",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第四章　人民检察院的人员组成",
      "section_name": "",
      "article_no_cn": "第三十九条",
      "article_no_int": 39,
      "content": "人民检察院检察长任期与产生它的人民代表大会每届任期相同。\n全国人民代表大会常务委员会和省、自治区、直辖市人民代表大会常务委员会根据本级人民检察院检察长的建议，可以撤换下级人民检察院检察长、副检察长和检察委员会委员。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_40",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第四章　人民检察院的人员组成",
      "section_name": "",
      "article_no_cn": "第四十条",
      "article_no_int": 40,
      "content": "人民检察院的检察官、检察辅助人员和司法行政人员实行分类管理。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_41",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第四章　人民检察院的人员组成",
      "section_name": "",
      "article_no_cn": "第四十一条",
      "article_no_int": 41,
      "content": "检察官实行员额制。检察官员额根据案件数量、经济社会发展情况、人口数量和人民检察院层级等因素确定。\n最高人民检察院检察官员额由最高人民检察院商有关部门确定。地方各级人民检察院检察官员额，在省、自治区、直辖市内实行总量控制、动态管理。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_42",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第四章　人民检察院的人员组成",
      "section_name": "",
      "article_no_cn": "第四十二条",
      "article_no_int": 42,
      "content": "检察官从取得法律职业资格并且具备法律规定的其他条件的人员中选任。初任检察官应当由检察官遴选委员会进行专业能力审核。上级人民检察院的检察官一般从下级人民检察院的检察官中择优遴选。\n检察长应当具有法学专业知识和法律职业经历。副检察长、检察委员会委员应当从检察官、法官或者其他具备检察官、法官条件的人员中产生。\n检察官的职责、管理和保障，依照《中华人民共和国检察官法》的规定。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_43",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第四章　人民检察院的人员组成",
      "section_name": "",
      "article_no_cn": "第四十三条",
      "article_no_int": 43,
      "content": "人民检察院的检察官助理在检察官指导下负责审查案件材料、草拟法律文书等检察辅助事务。\n符合检察官任职条件的检察官助理，经遴选后可以按照检察官任免程序任命为检察官。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
