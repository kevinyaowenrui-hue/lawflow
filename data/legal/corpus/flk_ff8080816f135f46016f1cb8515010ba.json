    },
    {
      "id": "flk_ff8080816f135f46016f1cb8515010ba:art_47",
      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第五章　人民检察院行使职权的保障",
      "section_name": "",
      "article_no_cn": "第四十七条",
      "article_no_int": 47,
      "content": "任何单位或者个人不得要求检察官从事超出法定职责范围的事务。\n对于领导干部等干预司法活动、插手具体案件处理，或者人民检察院内部人员过问案件情况的，办案人员应当全面如实记录并报告；有违法违纪情形的，由有关机关根据情节轻重追究行为人的责任。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
