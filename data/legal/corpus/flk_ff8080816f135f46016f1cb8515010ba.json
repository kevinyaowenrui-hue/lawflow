      "law_id": "flk_ff8080816f135f46016f1cb8515010ba",
      "part_name": "",
      "chapter_name": "第五章　人民检察院行使职权的保障",
      "section_name": "",
      "article_no_cn": "第四十八条",
      "article_no_int": 48,
      "content": "人民检察院采取必要措施，维护办案安全。对妨碍人民检察院依法行使职权的违法犯罪行为，依法追究法律责任。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff8080816f135f46016f1cb8515010ba",
