      "full_name": "中华人民共和国印花税法",
      "short_name": "印花税法",
      "hierarchy": 1,
      "promulgated_by": "全国人民代表大会常务委员会",
      "promulgated_doc_no": "",
      "effective_date": "2022-07-01",
