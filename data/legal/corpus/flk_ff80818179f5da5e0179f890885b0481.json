  ],
  "articles": [
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_1",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第一条",
      "article_no_int": 1,
      "content": "在中华人民共和国境内书立应税凭证、进行证券交易的单位和个人，为印花税的纳税人，应当依照本法规定缴纳印花税。\n在中华人民共和国境外书立在境内使用的应税凭证的单位和个人，应当依照本法规定缴纳印花税。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_2",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第二条",
      "article_no_int": 2,
      "content": "本法所称应税凭证，是指本法所附《印花税税目税率表》列明的合同、产权转移书据和营业账簿。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_3",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第三条",
      "article_no_int": 3,
      "content": "本法所称证券交易，是指转让在依法设立的证券交易所、国务院批准的其他全国性证券交易场所交易的股票和以股票为基础的存托凭证。\n证券交易印花税对证券交易的出让方征收，不对受让方征收。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_4",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第四条",
      "article_no_int": 4,
      "content": "印花税的税目、税率，依照本法所附《印花税税目税率表》执行。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_5",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第五条",
      "article_no_int": 5,
      "content": "印花税的计税依据如下：\n（一）应税合同的计税依据，为合同所列的金额，不包括列明的增值税税款；\n（二）应税产权转移书据的计税依据，为产权转移书据所列的金额，不包括列明的增值税税款；\n（三）应税营业账簿的计税依据，为账簿记载的实收资本（股本）、资本公积合计金额；\n（四）证券交易的计税依据，为成交金额。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_6",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第六条",
      "article_no_int": 6,
      "content": "应税合同、产权转移书据未列明金额的，印花税的计税依据按照实际结算的金额确定。\n计税依据按照前款规定仍不能确定的，按照书立合同、产权转移书据时的市场价格确定；依法应当执行政府定价或者政府指导价的，按照国家有关规定确定。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_7",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第七条",
      "article_no_int": 7,
      "content": "证券交易无转让价格的，按照办理过户登记手续时该证券前一个交易日收盘价计算确定计税依据；无收盘价的，按照证券面值计算确定计税依据。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_8",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第八条",
      "article_no_int": 8,
      "content": "印花税的应纳税额按照计税依据乘以适用税率计算。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_9",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第九条",
      "article_no_int": 9,
      "content": "同一应税凭证载有两个以上税目事项并分别列明金额的，按照各自适用的税目税率分别计算应纳税额；未分别列明金额的，从高适用税率。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_10",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十条",
      "article_no_int": 10,
      "content": "同一应税凭证由两方以上当事人书立的，按照各自涉及的金额分别计算应纳税额。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_11",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十一条",
      "article_no_int": 11,
      "content": "已缴纳印花税的营业账簿，以后年度记载的实收资本（股本）、资本公积合计金额比已缴纳印花税的实收资本（股本）、资本公积合计金额增加的，按照增加部分计算应纳税额。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_12",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十二条",
      "article_no_int": 12,
      "content": "下列凭证免征印花税：\n（一）应税凭证的副本或者抄本；\n（二）依照法律规定应当予以免税的外国驻华使馆、领事馆和国际组织驻华代表机构为获得馆舍书立的应税凭证；\n（三）中国人民解放军、中国人民武装警察部队书立的应税凭证；\n（四）农民、家庭农场、农民专业合作社、农村集体经济组织、村民委员会购买农业生产资料或者销售农产品书立的买卖合同和农业保险合同；\n（五）无息或者贴息借款合同、国际金融组织向中国提供优惠贷款书立的借款合同；\n（六）财产所有权人将财产赠与政府、学校、社会福利机构、慈善组织书立的产权转移书据；\n（七）非营利性医疗卫生机构采购药品或者卫生材料书立的买卖合同；\n（八）个人与电子商务经营者订立的电子订单。\n根据国民经济和社会发展的需要，国务院对居民住房需求保障、企业改制重组、破产、支持小型微型企业发展等情形可以规定减征或者免征印花税，报全国人民代表大会常务委员会备案。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_13",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十三条",
      "article_no_int": 13,
      "content": "纳税人为单位的，应当向其机构所在地的主管税务机关申报缴纳印花税；纳税人为个人的，应当向应税凭证书立地或者纳税人居住地的主管税务机关申报缴纳印花税。\n不动产产权发生转移的，纳税人应当向不动产所在地的主管税务机关申报缴纳印花税。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_14",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十四条",
      "article_no_int": 14,
      "content": "纳税人为境外单位或者个人，在境内有代理人的，以其境内代理人为扣缴义务人；在境内没有代理人的，由纳税人自行申报缴纳印花税，具体办法由国务院税务主管部门规定。\n证券登记结算机构为证券交易印花税的扣缴义务人，应当向其机构所在地的主管税务机关申报解缴税款以及银行结算的利息。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_15",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十五条",
      "article_no_int": 15,
      "content": "印花税的纳税义务发生时间为纳税人书立应税凭证或者完成证券交易的当日。\n证券交易印花税扣缴义务发生时间为证券交易完成的当日。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_16",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十六条",
      "article_no_int": 16,
      "content": "印花税按季、按年或者按次计征。实行按季、按年计征的，纳税人应当自季度、年度终了之日起十五日内申报缴纳税款；实行按次计征的，纳税人应当自纳税义务发生之日起十五日内申报缴纳税款。\n证券交易印花税按周解缴。证券交易印花税扣缴义务人应当自每周终了之日起五日内申报解缴税款以及银行结算的利息。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_17",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十七条",
      "article_no_int": 17,
      "content": "印花税可以采用粘贴印花税票或者由税务机关依法开具其他完税凭证的方式缴纳。\n印花税票粘贴在应税凭证上的，由纳税人在每枚税票的骑缝处盖戳注销或者画销。\n印花税票由国务院税务主管部门监制。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
      "verified_by": "",
      "review_note": "来自国家法律法规数据库现行文本自动切条，未经逐条律师复核。"
    },
    {
      "id": "flk_ff80818179f5da5e0179f890885b0481:art_18",
      "law_id": "flk_ff80818179f5da5e0179f890885b0481",
      "part_name": "",
      "chapter_name": "",
      "section_name": "",
      "article_no_cn": "第十八条",
      "article_no_int": 18,
      "content": "印花税由税务机关依照本法和《中华人民共和国税收征收管理法》的规定征收管理。",
      "has_proviso": 0,
      "key_terms": [],
      "claim_basis_type": "",
      "verification_status": "OFFICIAL_SOURCE",
      "source_url": "https://flk.npc.gov.cn/detail?bbbs=ff80818179f5da5e0179f890885b0481",
      "verified_at": "",
